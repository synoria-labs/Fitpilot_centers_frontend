# API Configuration
# Producción: https://webhook.fitpilot.fit   |   Local: http://127.0.0.1:8000
API_BASE_URL=https://webhook.fitpilot.fit
GRAPHQL_URL=https://webhook.fitpilot.fit/graphql
GRAPHQL_WS_URL=wss://webhook.fitpilot.fit/graphql
REST_USERS_URL=https://webhook.fitpilot.fit/users

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=15
ACCESS_TOKEN_EXPIRE_DAYS=7

# Environment: 'production' o 'development' (en minúscula; el código compara == 'production')
ENVIRONMENT=production
TIMEZONE=America/Mexico_City

# Application Settings
APP_NAME=FitPilot
APP_VERSION=1.0.0
LOG_LEVEL=INFO
